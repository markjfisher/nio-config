; int __near__ prompt_line (const char *label, char *buf, unsigned char cap)
; C version:   362 bytes
; ASM version: 000 bytes

; This is a LOT leaner than the C version.
; we don't check the params for null, as there's only 1 function that calls it
_prompt_line2:
        jsr     pusha                   ; save cap at c_sp+4

        ; allocate 5 bytes into C stack as temp area so we don't eat BSS
        jsr     decsp5                  ; c_sp

        ; Stack layout:
        ; c_sp + 0    |  x
        ; c_sp + 1    |  y
        ; c_sp + 2    |  clear_x
        ; c_sp + 3    |  width
        ; c_sp + 4    |  clear_width
        ; c_sp + 5    |  cap
        ; c_sp + 6,7  |  char *label
        ; c_sp + 8,9  |  char *buf


        ; get label into ptr1
        ldy     #$06
        lda     (c_sp), y
        sta     ptr1
        iny
        lda     (c_sp), y
        sta     ptr1+1

        ; NOTE: the only caller of this function provides a string, so no need for "Value" check that was in original C
        ; There's no other callers of label_width, so we'll remove it and just use the section we need:

        ldy     #$00
@len_loop:
        lda     (ptr1), y
        beq     @string_end
        iny
        cpy     #12                     ; don't go over 12, TODO: turn to a constant somewhere
        bcc     @len_loop

@string_end:
        sty     tmp2                    ; label length

        ldy     #$00

        lda     _current_screen
        cmp     #SCREEN_BROWSE
        bne     not_browse

        lda     #CONFIG_NIO_BBC_BROWSE_INPUT_TEXT_X
        sta     (c_sp), y               ; 0 -> x
        iny
        lda     #CONFIG_NIO_BBC_BROWSE_INPUT_Y
        sta     (c_sp), y               ; 1 -> y
        iny
        lda     #CONFIG_NIO_BBC_BROWSE_INPUT_LABEL_X
        sta     (c_sp), y               ; 2 -> clear_x
        iny
        lda     #CONFIG_NIO_BBC_BROWSE_INPUT_WIDTH
        sta     (c_sp), y               ; 3 -> width
        iny
        lda     #CONFIG_NIO_BBC_BROWSE_INPUT_CLEAR_WIDTH
        sta     (c_sp), y               ; 4 -> clear_width
        bne     check_cap

not_browse:
        lda     #BBC_HOST_TEXT_X
        sta     (c_sp), y               ; 0 -> x
        iny

        clc
        lda     #CONFIG_NIO_BBC_HOSTS_ROWS_Y
        adc     _selected_host
        sec
        sbc     _hosts_start
        sta     (c_sp), y               ; 1 -> y
        iny

        lda     #BBC_HOST_TEXT_X
        sta     (c_sp), y               ; 2 -> clear_x
        iny

        lda     #CONFIG_NIO_BBC_HOSTS_ROWS_URI_WIDTH
        sta     (c_sp), y               ; 3 -> width
        iny
        sta     (c_sp), y               ; 4 -> clear_width

check_cap:

        dey                             ; y = 3
        lda     (c_sp), y               ; width
        cmp     tmp1                    ; cap
        bcc     width_ok

        ; width = (cap - 1)
        lda     tmp1
        sec
        sbc     #$01
        sta     (c_sp), y               ; width -> cap - 1

width_ok:
        ; dispensing with the C version's "if (width == 0) return 0" as that can't happen

        ; call clear_field(clear_x, y, clear_width)
        jsr     decsp2

        dey                             ; y = 2 (clear_x)
        lda     (c_sp), y
        ldy     #1+5                    ; index clear_field(clear_x, .., ..)
        sta     (c_sp), y

        ldy     #1
        lda     (c_sp), y
        ldy     #0+5                    ; index for clear_field(.., y, ..)
        sta     (c_sp), y

        dey                             ; y = 4
        lda     (c_sp), y               ; clear_width
        jsr     _clear_field            

        lda     _current_screen
        cmp     SCREEN_BROWSE
        bne     not_browse2





not_browse2:


        ; reset stack, original 4 bytes, and our 5
        ldy     #9
        jsr     addysp

        ; exit with result
        ldx     #$00
        lda     #$00
        rts

; .rodata
; value_str:      .byte "Value", 0

